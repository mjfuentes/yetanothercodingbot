e-item\">\n                        <div class=\"experience-header\">\n                            <h3 class=\"experience-title\">Independent Projects & Collaborations</h3>\n                            <p class=\"experience-date\">2020 - Present</p>\n                        </div>\n                        <p class=\"experience-role\">Freelance Dancer & Movement Director</p>\n                        <p class=\"section-text\">\n                            Ongoing collaborations with choreographers and directors across Europe.\n                            Creating and performing in independent dance projects, music videos, and\n                            experimental performance art. Movement direction for theatrical productions\n                            and commercial projects.\n                        </p>\n                    </div>\n                </div>\n\n                <div class=\"skills-section\">\n                    <h3 class=\"subsection-heading\">Skills & Specialties</h3>\n                    <div class=\"skills-grid\">\n                        <div class=\"skill-category\">\n                            <h4 class=\"skill-title\">Classical Dance</h4>\n                            <p class=\"section-text\">Vaganova Method \u00b7 Classical Ballet \u00b7 Character Dance \u00b7 Historical Dance</p>\n                        </div>\n                        <div class=\"skill-category\">\n                            <h4 class=\"skill-title\">Contemporary Techniques</h4>\n                            <p class=\"section-text\">Graham \u00b7 Gaga \u00b7 Horton \u00b7 Release Technique \u00b7 Contact Improvisation</p>\n                        </div>\n                        <div class=\"skill-category\">\n                            <h4 class=\"skill-title\">Choreographic Styles</h4>\n                            <p class=\"section-text\">Crystal Pite \u00b7 Sidi Larbi Cherkaoui \u00b7 Akram Khan \u00b7 Jiri Kylian \u00b7 Marco Goecke \u00b7 Sharon Eyal</p>\n       